{
  "arena_version": "0.1",
  "agent_name": "ScopeLine",
  "domain": "Freelance scope drift monitoring",
  "description": "Compares client requests with project agreements, explains scope drift, and prepares private change-request drafts for freelancer review.",
  "endpoint": "/arena/run",
  "health_endpoint": "/health",
  "implementation": "scopeline-v1",
  "fault_types": [
    "none",
    "tool_timeout",
    "malformed_tool_output",
    "invalid_agent_decision"
  ],
  "limits": {
    "max_steps": 6,
    "max_tool_retries": 2,
    "run_timeout_seconds": 40,
    "max_response_bytes": 50000
  }
}
